<?xml version="1.0" encoding="utf-8"?>
<!--
  The database is a location history: it never leaves the device on its own.
  Android 12+ consults this file instead of allowBackup, so both channels are
  disabled explicitly rather than relying on the legacy flag alone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
